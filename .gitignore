# ============================
# Java DSA Studio .gitignore
# ============================

# Java build artifacts
*.class
*.jar
*.war
*.ear
*.log
build/
out/
bin/

# IDE files
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# Node.js dependencies
web/node_modules/

# Sandbox temp build directory
web/temp/

# Learner state written at runtime (profile, progress, tutor memory)
web/data/store/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Environment files (API keys)
.env
.env.*
*.env

# Markdown files (ignore all markdown files except root README.md)
*.md
!README.md

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
